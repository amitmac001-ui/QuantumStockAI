DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
REDIS_URL=rediss://user:password@host:6379/0
UPSTOX_CLIENT_ID=replace-me
UPSTOX_CLIENT_SECRET=replace-me
UPSTOX_REDIRECT_URI=https://app.example.com/api/v1/upstox/callback/
UPSTOX_ACCESS_TOKEN=replace-me
GOOGLE_SHEETS_ENABLED=False
CLOUD_COMPACT_MARKET_DATA=False
